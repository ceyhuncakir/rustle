#!/usr/bin/env bash
# Thin D-Bus client for the island. This is the same surface flowd drives,
# so anything flowctl can do, the daemon can do.
set -euo pipefail

DEST=ai.flow.Island
PATH_=/ai/flow/Island

call() {
    local method="$1"; shift
    gdbus call --session --dest "$DEST" --object-path "$PATH_" \
        --method "$DEST.$method" "$@"
}

case "${1:-}" in
    show)    call Show ;;
    hide)    call Hide ;;
    state)   call SetState "${2:?usage: flowctl state <idle|listening|thinking|inserting|error>}" ;;
    text)    call SetText "${2-}" ;;
    level)   call PushLevel "${2:?usage: flowctl level <0.0-1.0>}" ;;
    insert)  call InsertText "${2:?usage: flowctl insert <text>}" ;;
    context) call GetFocusContext ;;
    status)
        gdbus call --session --dest "$DEST" --object-path "$PATH_" \
            --method org.freedesktop.DBus.Properties.Get "$DEST" State
        ;;
    *)
        cat <<'USAGE'
usage: flowctl <command>

  show                 show the island in its idle state
  hide                 dismiss the island
  state <name>         idle | listening | thinking | inserting | error
  text <string>        set the transcript line (empty string clears it)
  level <0.0-1.0>      push one audio amplitude sample
  insert <string>      paste text into the focused window
  context              print the focused app, title and role
  status               print the current island state
USAGE
        exit 1
        ;;
esac
