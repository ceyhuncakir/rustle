{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Rustle's own windows may call.",
  "windows": ["overlay", "settings", "first-run"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:event:default",
    "opener:default",
    "autostart:default",
    "notification:default"
  ]
}
