[Unit]
Description=Rustle dictation daemon
Documentation=https://github.com/ceyhuncakir/rustle
# Started with the desktop and stopped with it: it needs the session's
# display and bus, which do not outlive the graphical session.
PartOf=graphical-session.target
After=graphical-session.target
# A build that crashes at start would otherwise reload the speech model
# every few seconds forever. After five failures in two minutes systemd
# gives up; `systemctl --user reset-failed rustle` re-arms it.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/rustle --headless
Restart=on-failure
RestartSec=5
# Rustle unloads its models on SIGTERM within a second or two; do not hold up
# a logout for systemd's default 90 s if that ever hangs.
TimeoutStopSec=15
Slice=app.slice

[Install]
WantedBy=graphical-session.target
