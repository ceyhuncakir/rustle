[Unit]
Description=Flow dictation daemon
Documentation=https://github.com/ceyhuncakir/flow
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/flow --headless
Restart=on-failure
RestartSec=3
TimeoutStartSec=300
Slice=app.slice

[Install]
WantedBy=graphical-session.target
