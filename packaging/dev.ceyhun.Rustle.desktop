[Desktop Entry]
Type=Application
Name=Rustle
GenericName=Voice Typing
Comment=Local voice dictation - settings, models and status
Icon=rustle
Exec=rustle
Terminal=false
StartupNotify=false
Categories=Utility;Accessibility;
Keywords=dictation;dictate;speech;voice;transcribe;stt;whisper;microphone;
Actions=Start;Stop;

[Desktop Action Start]
Name=Start Dictation
Exec=systemctl --user start rustle

[Desktop Action Stop]
Name=Stop Dictation
Exec=systemctl --user stop rustle
